{% set rel = ansible_facts['distribution_release'] %}
{% if use_arcus_mirror | default(false) | bool %}
Types: deb
URIs: https://mirrors.arcuslayer.com/ubuntu/
Suites: {{ rel }} {{ rel }}-updates {{ rel }}-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: https://mirrors.arcuslayer.com/ubuntu/
Suites: {{ rel }}-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

{% endif %}
Types: deb
URIs: https://archive.ubuntu.com/ubuntu/
Suites: {{ rel }} {{ rel }}-updates {{ rel }}-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: https://security.ubuntu.com/ubuntu/
Suites: {{ rel }}-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

